# ==========================================
# CENTIVATE SYSTEM ENVIRONMENT CONFIGURATION
# ==========================================

# NODE_ENV: Application execution environment ('development', 'staging', 'production')
NODE_ENV="development"

# GEMINI_API_KEY: Required for server-side Gemini 3.6 Flash AI facility diagnosis & safety checks.
# Injected automatically at runtime from AI Studio secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL of the hosted Cloud Run application.
# Used for canonical links, OAuth redirects, and internal API routing.
APP_URL="MY_APP_URL"

# ADMIN_DEV_BYPASS_TOKEN: LOCAL DEVELOPMENT ONLY.
# Lets you hit admin-only endpoints during prototyping before real Firebase
# auth is wired up, by sending header: x-admin-authorization: <this value>
# - Only works when NODE_ENV !== 'production' (hardcoded check in api/app.ts).
# - Pick your own random value locally; do NOT reuse this example value.
# - NEVER set this in Vercel/production environment variables.
ADMIN_DEV_BYPASS_TOKEN="set-a-random-local-only-value"

# SIGNUP_ACCESS_CODE: Given to student/teacher pilot respondents so they can
# self-register (Create Account) without needing an @cpu.edu.ph email.
SIGNUP_ACCESS_CODE="set-a-pilot-access-code"

# ADMIN_SIGNUP_CODE: Kept by the research team only. Required to create an
# admin/facilities account via the same Create Account flow. Keep this
# different from, and stronger than, SIGNUP_ACCESS_CODE.
ADMIN_SIGNUP_CODE="set-a-separate-admin-only-code"

# RESEND_API_KEY: Free-tier API key from https://resend.com — used to email
# a maintenance staff member automatically when a complaint is assigned to
# them. Leave unset to disable assignment emails (they're skipped silently).
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender shown on assignment emails. Resend's shared
# "onboarding@resend.dev" address works out of the box with no domain setup
# and can send to any recipient — fine for a pilot with dummy staff emails.
RESEND_FROM_EMAIL="Centivate Facilities <onboarding@resend.dev>"

# FIREBASE_SERVICE_ACCOUNT_KEY: Required for the server (Admin SDK) to read/
# write Firestore and verify login tokens. Outside GCP (Vercel, local dev)
# there's no ambient Application Default Credentials, so this must be set
# explicitly: Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key -> paste the ENTIRE downloaded JSON file's
# contents as this variable's value (not a file path — Vercel has no
# persistent filesystem to put the file on, and it must never be committed
# to the repo). Without this set, the app still runs — GET routes fall back
# to in-memory seed data — but signup/login and all writes are disabled.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# SEED_DEMO_DATA: Set to "true" ONLY to fill an empty Firestore with the demo
# complaints/staff/surveys. Leave unset in production so real research data is
# never mixed with fake records. (Local dev without Firebase credentials always
# uses the in-memory demo data regardless of this flag.)
SEED_DEMO_DATA=""

# ==========================================
# KNOWN DEPLOYMENT & ENVIRONMENT NOTES
# ==========================================
# 1. Environment Separation: Currently operating under single-environment Cloud Run config.
#    For enterprise staging/production pipelines, create distinct GCP projects (e.g. centivate-dev, centivate-prod).
# 2. Image Blob Storage Recommendation: Photo attachments are compressed client-side (max 800x800, ~50KB)
#    and validated server-side (<500KB) to remain safely within Firestore's 1MiB document limit.
#    For multi-gigabyte media storage, migrate attachments to Firebase Storage / Google Cloud Storage buckets.
