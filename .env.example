# ==========================================
# CENTIVATE SYSTEM ENVIRONMENT CONFIGURATION
# ==========================================

# NODE_ENV: Application execution environment ('development', 'staging', 'production')
NODE_ENV="development"

# GEMINI_API_KEY: Required for server-side Gemini 3.6 Flash AI facility diagnosis & safety checks.
# Injected automatically at runtime from AI Studio secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL of the hosted Cloud Run application.
# Used for canonical links, OAuth redirects, and internal API routing.
APP_URL="MY_APP_URL"

# ADMIN_DEV_BYPASS_TOKEN: LOCAL DEVELOPMENT ONLY.
# Lets you hit admin-only endpoints during prototyping before real Firebase
# auth is wired up, by sending header: x-admin-authorization: <this value>
# - Only works when NODE_ENV !== 'production' (hardcoded check in api/app.ts).
# - Pick your own random value locally; do NOT reuse this example value.
# - NEVER set this in Vercel/production environment variables.
ADMIN_DEV_BYPASS_TOKEN="set-a-random-local-only-value"

# FIREBASE ADMIN CONFIGURATION:
# The server Express backend uses firebase-admin (Google Application Default Credentials or Project ID)
# to maintain a secure backend trust boundary for all database reads and writes.
GOOGLE_CLOUD_PROJECT="deductive-plate-q98sv"

# ==========================================
# KNOWN DEPLOYMENT & ENVIRONMENT NOTES
# ==========================================
# 1. Environment Separation: Currently operating under single-environment Cloud Run config.
#    For enterprise staging/production pipelines, create distinct GCP projects (e.g. centivate-dev, centivate-prod).
# 2. Image Blob Storage Recommendation: Photo attachments are compressed client-side (max 800x800, ~50KB)
#    and validated server-side (<500KB) to remain safely within Firestore's 1MiB document limit.
#    For multi-gigabyte media storage, migrate attachments to Firebase Storage / Google Cloud Storage buckets.
