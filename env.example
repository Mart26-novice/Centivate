# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_DEV_BYPASS_TOKEN: LOCAL DEVELOPMENT ONLY.
# Lets you hit admin-only endpoints during prototyping before real Firebase
# auth is wired up, by sending header: x-admin-authorization: <this value>
# - Only works when NODE_ENV !== 'production' (hardcoded check in api/app.ts).
# - Pick your own random value locally; do NOT reuse this example value.
# - NEVER set this in Vercel/production environment variables.
ADMIN_DEV_BYPASS_TOKEN="set-a-random-local-only-value"

# SIGNUP_ACCESS_CODE: Given to student/teacher pilot respondents so they can
# self-register (Create Account) without needing an @cpu.edu.ph email.
SIGNUP_ACCESS_CODE="set-a-pilot-access-code"

# ADMIN_SIGNUP_CODE: Kept by the research team only. Required to create an
# admin/facilities account via the same Create Account flow. Keep this
# different from, and stronger than, SIGNUP_ACCESS_CODE.
ADMIN_SIGNUP_CODE="set-a-separate-admin-only-code"

# RESEND_API_KEY: Free-tier API key from https://resend.com — used to email
# a maintenance staff member automatically when a complaint is assigned to
# them. Leave unset to disable assignment emails (they're skipped silently).
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender shown on assignment emails. Resend's shared
# "onboarding@resend.dev" address works out of the box with no domain setup
# and can send to any recipient — fine for a pilot with dummy staff emails.
RESEND_FROM_EMAIL="Centivate Facilities <onboarding@resend.dev>"
