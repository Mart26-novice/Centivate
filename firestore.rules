rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Design note: complaints, surveys and staff are written ONLY by the Express API (Admin SDK,
    // which bypasses these rules) after validation and authorization. The client SDK is read-only
    // and only for admins (plus a user's own profile), so nothing here needs to be publicly readable.

    function isSignedIn() {
      return request.auth != null;
    }

    // Real (non-anonymous) Firebase Auth credentials
    function isEmailAuth() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admin = users/{uid}.role == 'admin' (written server-side only), or an allowlisted address
    // whose email is VERIFIED (Firebase lets anyone register any address, unverified).
    function isAdmin() {
      return isEmailAuth() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin') ||
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'admin.facilities@cpu.edu.ph' ||
          request.auth.token.email == 'admin@cpu.edu.ph' ||
          request.auth.token.email == 'admin.demo@cpu.edu.ph'
        ))
      );
    }

    // User profiles: a user reads only their own; admins read all. Never writable from the client
    // (prevents self-assigned admin role).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Complaints hold names, emails and photos: admin-only via the client SDK.
    // Public tracking and students' own reports go through the API.
    match /complaints/{complaintId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /students/{studentId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /surveys/{surveyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reject everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
