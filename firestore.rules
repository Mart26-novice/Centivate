rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Ensures user is logged in with real non-anonymous Firebase Auth credentials
    function isEmailAuth() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isEmailAuth() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin') ||
        request.auth.token.email == 'admin.facilities@cpu.edu.ph' ||
        request.auth.token.email == 'admin@cpu.edu.ph' ||
        request.auth.token.email == 'admin.demo@cpu.edu.ph'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function hasRequiredKeys(data, keys) {
      return data.keys().hasAll(keys);
    }

    // User Profiles collection - read-only from client to prevent privilege escalation
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Complaints collection
    match /complaints/{complaintId} {
      // Allow single document read (get) for public tracker lookup by tracking code / doc ID, but restrict list queries to authenticated users
      allow get: if true;
      allow list: if isEmailAuth();

      // Allow creating a complaint if required fields are present and valid
      allow create: if isValidId(complaintId)
                    && hasRequiredKeys(request.resource.data, ['trackingCode', 'title', 'description', 'category', 'status'])
                    && request.resource.data.trackingCode is string
                    && request.resource.data.title is string && request.resource.data.title.size() <= 200
                    && request.resource.data.description is string && request.resource.data.description.size() <= 5000
                    && (!('photoUrl' in request.resource.data) || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 500000));

      // Allow authenticated staff/admin or email auth users to update complaints with size constraints
      allow update: if isEmailAuth()
                    && (!('resolutionPhotoUrl' in request.resource.data) || (request.resource.data.resolutionPhotoUrl is string && request.resource.data.resolutionPhotoUrl.size() <= 500000));

      // Restrict deletion to authenticated admin users
      allow delete: if isAdmin();
    }

    // Official Student Directory collection
    match /students/{studentId} {
      allow read: if isEmailAuth();
      allow create, update, delete: if isAdmin();
    }

    // Maintenance Staff Directory collection
    match /staff/{staffId} {
      allow read: if isEmailAuth();
      allow create, update, delete: if isAdmin();
    }

    // Survey Responses collection
    match /surveys/{surveyId} {
      allow read: if isEmailAuth();
      allow create: if isValidId(surveyId)
                    && hasRequiredKeys(request.resource.data, ['role', 'submittedAt'])
                    && request.resource.data.role is string;
      allow update, delete: if isAdmin();
    }

    // Default catch-all rule: reject all unhandled collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
